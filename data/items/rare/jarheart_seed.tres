[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PermanentGrowthEffect.gd" id="2_growth"]
[ext_resource type="Texture2D" path="res://assets/items/sigil-rpg-game-icons/8.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_growth")
stacking_notes = "Each direct player container break grants +1 max HP. One shared listener; base round cap is +10 max HP, each extra copy adds +5 round cap."
trigger = &"container_broken"
growth_stat = &"max_hp"
growth_value = 1.0
round_cap = 10.0
stack_round_cap_bonus = 5.0
requires_direct_player_attack = true

[resource]
script = ExtResource("1_def")
id = &"jarheart_seed"
display_name = "Jarheart Seed"
description = "Whenever you break a container, permanently gain +1 Max HP. Max +10 Max HP per round; extra copies add +5 to the round cap."
category = &"defense"
rarity = &"rare"
tags = Array[StringName]([&"Container", &"MaxHP", &"Scaling"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
