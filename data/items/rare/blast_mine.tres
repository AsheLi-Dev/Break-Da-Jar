[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PeriodicEffect.gd" id="2_periodic"]
[ext_resource type="Texture2D" path="res://assets/items/Magic Book Game Icons/27.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_periodic")
stacking_rule = &"shared_runtime_scaled"
stacking_notes = "One monitor handles all copies and maintains at most one pending trap. Damage is 100% ATK +50% ATK per extra copy."
mode = &"periodic_explosive_trap"
value = 1.0
radius = 200.0
damage_scale = 0.5
interval = 10.0

[resource]
script = ExtResource("1_def")
id = &"blast_mine"
display_name = "Blast Mine"
description = "Every 10 seconds, place an explosive trap under you. It explodes when an enemy is within 200px, dealing 100% ATK damage in a 200px radius. Extra copies add 50% ATK damage."
category = &"attack"
rarity = &"rare"
tags = Array[StringName]([&"Trap", &"Explosion", &"Damage"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
