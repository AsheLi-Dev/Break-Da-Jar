[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PermanentGrowthEffect.gd" id="2_growth"]
[ext_resource type="Texture2D" path="res://assets/items/_unused/fairy-loot-game-icons/27.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_growth")
stacking_notes = "At round start, reset damage tracking. At round end, if no HP damage was taken, permanently add flat movement speed."
trigger = &"round_ended"
growth_stat = &"bonus_move_speed_flat"
growth_value = 10.0
requires_no_damage_round = true

[resource]
script = ExtResource("1_def")
id = &"untouched_stride"
display_name = "Untouched Stride"
description = "At the end of a round, if you took no damage that round, permanently gain +10 Movement Speed."
category = &"utility"
rarity = &"rare"
tags = Array[StringName]([&"NoDamage", &"MoveSpeed", &"Scaling"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
