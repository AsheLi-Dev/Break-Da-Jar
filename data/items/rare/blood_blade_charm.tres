[resource]
script = ExtResource("1_def")
id = &"blood_blade_charm"
display_name = "Blood Blade Charm"
description = "Every 5 seconds, launch a piercing Blood Blade at the nearest enemy within 300px. It lasts 0.5 seconds, deals 50% ATK damage to each enemy hit, and applies Bleeding. Extra copies add one additional Blood Blade, released 0.5 seconds after the previous one."
category = &"attack"
rarity = &"rare"
tags = Array[StringName]([&"Blood", &"AutoCast", &"Bleeding", &"Damage"])
effects = Array[Resource]([SubResource("Resource_effect")])
