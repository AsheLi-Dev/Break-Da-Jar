[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PeriodicEffect.gd" id="2_periodic"]
[ext_resource type="Texture2D" path="res://assets/items/bleed-icons/Sword_RPG_Icons_46.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_periodic")
stacking_rule = &"shared_runtime_scaled"
stacking_notes = "One monitor handles all copies. Every copy adds one extra blade released 0.5s after the previous blade."
mode = &"periodic_blood_blade"
value = 0.5
duration = 0.5
radius = 300.0
chance = 0.5
damage_scale = 400.0
interval = 5.0

[resource]
script = ExtResource("1_def")
id = &"blood_blade_charm"
display_name = "Blood Blade Charm"
description = "Every 5 seconds, fire a piercing Blood Blade at the nearest enemy."
category = &"attack"
rarity = &"rare"
tags = Array[StringName]([&"Blood", &"AutoCast", &"Bleeding", &"Damage"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
