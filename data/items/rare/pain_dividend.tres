value = 10.0

[resource]
script = ExtResource("1_def")
id = &"pain_dividend"
display_name = "Pain Dividend"
description = "Gain 1 gold for every 10 HP you lose. Progress resets after each payout."
category = &"utility"
rarity = &"rare"
tags = Array[StringName]([&"Economy", &"OnDamageTaken", &"Gold"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
