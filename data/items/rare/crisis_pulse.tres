[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PeriodicEffect.gd" id="2_periodic"]
[ext_resource type="Texture2D" path="res://assets/items/dark_realistic_pixel_icons/crisis_pulse.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_periodic")
stacking_rule = &"shared_runtime_scaled"
stacking_notes = "Surrounded means enemies within 220px. One monitor reads copy count; extra copies add +50% per-enemy effect and +50% cap."
mode = &"surrounded_stat_bonus"
stat_name = &"movement_speed_bonus"
value = 0.06
duration = 0.3
damage_scale = 0.03

[resource]
script = ExtResource("1_def")
id = &"crisis_pulse"
display_name = "Crisis Pulse"
description = "Nearby enemies increase Move Speed, up to +36%."
category = &"utility"
rarity = &"rare"
tags = Array[StringName]([&"Surrounded", &"MoveSpeed"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
