[gd_resource type="Resource" script_class="ItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_counter_cap_per_copy"
stacking_notes = "All copies share one kill counter; each copy adds +50 max HP cap."
event_name = &"enemy_killed"
effect_type = &"stat_bonus_every_n_kills_shared"
stat_name = &"max_hp"
value = 10.0
duration = 50.0
max_stacks = 5

[resource]
script = ExtResource("1_def")
id = &"bone_graft_totem"
display_name = "Bone Graft Totem"
description = "Every 5 enemy kills, gain +10 max HP. Max +50 max HP per copy."
category = &"defense"
rarity = &"rare"
tags = Array[StringName]([&"OnKill", &"MaxHP", &"Scaling"])
effects = Array[Resource]([SubResource("Resource_effect")])
