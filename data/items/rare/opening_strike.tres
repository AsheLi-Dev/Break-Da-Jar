[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/StatModifierEffect.gd" id="2_stat"]
[ext_resource type="Texture2D" path="res://assets/items/mace-rpg-game-icons/32.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_stat")
stat_name = &"high_hp_direct_damage_bonus"
operation = &"add"
value = 0.2

[resource]
script = ExtResource("1_def")
id = &"opening_strike"
