[gd_resource type="Resource" script_class="ItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"linear_summon_count"
stacking_notes = "Each copy listens independently and summons one more turret on level up."
event_name = &"player_leveled_up"
effect_type = &"summon_turret_on_level_up"
duration = 10.0
radius = 24.0
damage_scale = 0.5

[resource]
script = ExtResource("1_def")
id = &"level_up_turret_core"
display_name = "Level-Up Turret Core"
description = "When you level up, summon a small turret for 10 seconds."
category = &"utility"
rarity = &"rare"
tags = Array[StringName]([&"LevelUp", &"Summon", &"Turret"])
effects = Array[Resource]([SubResource("Resource_effect")])
