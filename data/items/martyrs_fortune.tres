[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/TriggeredBuffEffect.gd" id="2_buff"]
[ext_resource type="Texture2D" path="res://assets/items/_unused/Demon Loot Vector Icons/47.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_buff")
stacking_rule = &"shared_missing_hp_scaled"
stacking_notes = "One listener handles all copies. First copy gives +8 Luck per 10 missing HP; extra copies add +2 Luck per 10 missing HP."
event_name = &"hp_changed"
mode = &"missing_hp_stat_bonus"
stat_name = &"luck"
value = 8.0
stack_value_bonus = 2.0

[resource]
script = ExtResource("1_def")
id = &"martyrs_fortune"
display_name = "Martyr's Fortune"
description = "For every 10 missing HP, gain +8 Luck. Extra copies add +2 Luck per 10 missing HP."
category = &"utility"
rarity = &"legendary"
tags = Array[StringName]([&"MissingHP", &"Luck"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
