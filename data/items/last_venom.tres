[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/dark_realistic_pixel_icons/last_venom.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_poison_transfer_scaled"
stacking_notes = "One listener handles all copies. First copy transfers poison to the nearest 2 other enemies; extra copies add 1 additional nearest target."
event_name = &"enemy_killed"
effect_type = &"poison_transfer_on_death"
max_stacks = 2
radius = 240.0

[resource]
script = ExtResource("1_def")
id = &"last_venom"
display_name = "Last Venom"
description = "When a Poisoned enemy dies, its poison spreads to 2 nearby enemies."
category = &"attack"
rarity = &"legendary"
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
