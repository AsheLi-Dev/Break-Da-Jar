[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/StatModifierEffect.gd" id="2_stat"]
[ext_resource type="Texture2D" path="res://assets/items/_unused/daemon-monster-loot-rpg-icons/44.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_stat")
stacking_rule = &"chance_multiplicative"
stacking_notes = "Dodge chance is 1 - 0.9^copies."
stat_name = &"dodge_chance_multiplier"
operation = &"multiply"
value = 0.9

[resource]
script = ExtResource("1_def")
id = &"lucky_footwork"
display_name = "Lucky Footwork"
description = "Gain a 10% chance to dodge incoming damage."
category = &"defense"
rarity = &"common"
tags = Array[StringName]([&"Dodge", &"Defense"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
