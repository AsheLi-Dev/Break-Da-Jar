[gd_resource type="Resource" script_class="ItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_runtime_scaled"
stacking_notes = "One monitor reads copy count; copies increase attack speed, not stationary time or linger duration."
effect_type = &"stationary_attack_speed"
stat_name = &"attack_speed_bonus"
value = 0.2
duration = 1.0
radius = 1.0

[resource]
script = ExtResource("1_def")
id = &"stillness_trigger"
display_name = "Stillness Trigger"
description = "After standing still for 1 second, gain 20% attack speed. After moving, it lasts 1 second. Extra copies add attack speed only."
category = &"attack"
rarity = &"common"
tags = Array[StringName]([&"Stationary", &"AttackSpeed"])
effects = Array[Resource]([SubResource("Resource_effect")])
