[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/chest-and-treasure-game-icon-set/37.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_limited_trigger_scaled_by_copies"
stacking_notes = "All copies share one 5-trigger limit; each copy adds +10% refund rate."
event_name = &"shop_container_broken"
effect_type = &"refund_gold_on_shop_container_break"
value = 0.1
max_stacks = 5

[resource]
script = ExtResource("1_def")
id = &"shop_refund_charm"
display_name = "Shop Refund Charm"
description = "Breaking a shop jar refunds 10% of its price, up to 5 times."
category = &"utility"
rarity = &"common"
tags = Array[StringName]([&"Economy", &"Shop", &"Container"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
