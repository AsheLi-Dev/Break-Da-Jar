[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PermanentGrowthEffect.gd" id="2_growth"]
[ext_resource type="Texture2D" path="res://assets/items/sigil-rpg-game-icons/41.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_growth")
stacking_notes = "Critical direct player-attack kills grant +2% critical damage. One shared listener; base round cap is +10%, each extra copy adds +5% round cap."
trigger = &"enemy_killed"
growth_stat = &"critical_damage_bonus"
growth_value = 0.02
round_cap = 0.1
stack_round_cap_bonus = 0.05
requires_direct_player_attack = true
requires_critical = true

[resource]
script = ExtResource("1_def")
id = &"crimson_grindstone"
display_name = "Crimson Grindstone"
description = "When a critical direct attack kills an enemy, permanently gain +2% Critical Damage. Max +10% per round; extra copies add +5% to the round cap."
category = &"attack"
rarity = &"common"
tags = Array[StringName]([&"Critical", &"Attack", &"Scaling"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
