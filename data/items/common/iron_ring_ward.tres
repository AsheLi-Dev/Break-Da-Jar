[gd_resource type="Resource" script_class="ItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_runtime_scaled"
stacking_notes = "Surrounded means enemies within 220px. One monitor reads copy count; extra copies add +50% per-enemy effect and +50% cap."
effect_type = &"surrounded_stat_bonus"
stat_name = &"defense"
value = 4.0
duration = 20.0
damage_scale = 2.0

[resource]
script = ExtResource("1_def")
id = &"iron_ring_ward"
display_name = "Iron Ring Ward"
description = "Gain +4 DEF per surrounding enemy within 220px, up to +20 DEF. Extra copies increase the per-enemy bonus and cap by 50%."
category = &"defense"
rarity = &"common"
tags = Array[StringName]([&"Surrounded", &"Defense"])
effects = Array[Resource]([SubResource("Resource_effect")])
