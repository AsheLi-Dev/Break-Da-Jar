[gd_resource type="Resource" script_class="ItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"pickup_once"
stacking_notes = "Each copy queues one extra rare jar for the next shop refresh when obtained."
effect_type = &"queue_extra_rare_shop_jar"
value = 1.0
max_stacks = 1

[resource]
script = ExtResource("1_def")
id = &"rare_order_ticket"
display_name = "Rare Order Ticket"
description = "After you get this item, your next shop refresh includes one extra rare jar."
category = &"utility"
rarity = &"common"
tags = Array[StringName]([&"Shop", &"Rare", &"Container"])
effects = Array[Resource]([SubResource("Resource_effect")])
