[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PermanentGrowthEffect.gd" id="2_growth"]
[ext_resource type="Texture2D" path="res://assets/items/dark_realistic_pixel_icons/patient_whetstone.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_growth")
stacking_notes = "Non-critical direct player-attack kills grant +1% crit chance. One shared listener; base round cap is +5%, each extra copy adds +3% round cap."
trigger = &"enemy_killed"
growth_stat = &"critical_chance"
growth_value = 0.01
round_cap = 0.05
stack_round_cap_bonus = 0.03
requires_direct_player_attack = true
requires_non_critical = true

[resource]
script = ExtResource("1_def")
id = &"patient_whetstone"
display_name = "Patient Whetstone"
description = "Non-critical attack kills permanently give +1% Crit Chance, up to +5% per round."
category = &"attack"
rarity = &"common"
tags = Array[StringName]([&"Critical", &"Attack", &"Scaling"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
