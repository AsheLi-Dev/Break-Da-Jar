[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/_unused/daemon-monster-loot-rpg-icons/5.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"chance_multiplicative"
stacking_notes = "Heal chance stacks as 1 - (1 - 0.1)^copies; one listener handles all copies."
event_name = &"enemy_killed"
effect_type = &"chance_heal_on_kill"
value = 5.0
chance = 0.1

[resource]
script = ExtResource("1_def")
id = &"merciful_tally"
display_name = "Merciful Tally"
description = "Killing an enemy has a 10% chance to heal 5 HP."
category = &"defense"
rarity = &"common"
tags = Array[StringName]([&"OnKill", &"Heal"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
