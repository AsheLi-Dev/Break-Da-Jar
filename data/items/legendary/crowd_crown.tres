[gd_resource type="Resource" script_class="ItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"pickup_once"
stacking_notes = "First copy adds +3 to surrounded enemy count. Extra copies add +1."
effect_type = &"first_copy_stat_bonus"
stat_name = &"surrounded_enemy_count_bonus"
value = 3.0
damage_scale = 1.0

[resource]
script = ExtResource("1_def")
id = &"crowd_crown"
display_name = "Crowd Crown"
description = "Surrounded effects count +3 additional nearby enemies. Extra copies add +1."
category = &"utility"
rarity = &"legendary"
tags = Array[StringName]([&"Surrounded", &"Utility"])
effects = Array[Resource]([SubResource("Resource_effect")])
