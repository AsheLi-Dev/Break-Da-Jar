[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/dark_realistic_pixel_icons/round_start_turret_battery.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"linear_summon_count"
stacking_notes = "Each copy listens independently and summons two more turrets at round start."
event_name = &"round_started"
effect_type = &"summon_turrets_on_round_start"
duration = 15.0
radius = 32.0
damage_scale = 0.5
chain_count = 2

[resource]
script = ExtResource("1_def")
id = &"round_start_turret_battery"
display_name = "Round Start Turret Battery"
description = "At round start, summon 2 small turrets for 10 seconds."
category = &"utility"
rarity = &"legendary"
tags = Array[StringName]([&"RoundStart", &"Summon", &"Turret"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
