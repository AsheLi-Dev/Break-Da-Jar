[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/rings-and-jewelry-game-icons/37.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_sequence_scaled"
stacking_notes = "One listener handles all copies. On each kill, first copy releases 2 fireballs; extra copies add 1 fireball. Fireballs are released 0.5s apart."
event_name = &"enemy_killed"
effect_type = &"fireball_sequence_on_poisoned_death"
chain_count = 2
radius = 600.0
chance = 0.5
damage_scale = 1.0
duplicate_projectile_spread_degrees = 10.0

[resource]
script = ExtResource("1_def")
id = &"five_kill_fireburst"
display_name = "Plague Fire"
description = "Poisoned enemies explode into 2 fireballs when they die."
category = &"attack"
rarity = &"legendary"
tags = Array[StringName]([&"Poison", &"OnKill", &"Fireball"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
