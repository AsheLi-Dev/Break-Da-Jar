[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PermanentGrowthEffect.gd" id="2_growth"]
[ext_resource type="Texture2D" path="res://assets/items/dark_realistic_pixel_icons/goldroot_totem.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_growth")
stacking_notes = "At round start, gain +1 max HP per 10 gold held. Base trigger cap is 10, each extra copy adds +5 trigger cap."
trigger = &"round_started"
growth_stat = &"max_hp"
growth_value = 1.0
trigger_value = 10.0
round_cap = 10.0
stack_round_cap_bonus = 5.0
use_current_gold = true

[resource]
script = ExtResource("1_def")
id = &"goldroot_totem"
display_name = "Goldroot Totem"
description = "At round start, every 10 gold can permanently give +1 Max HP, up to +10."
category = &"defense"
rarity = &"legendary"
tags = Array[StringName]([&"Economy", &"RoundStart", &"MaxHP", &"Scaling"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
