[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/_unused/daemon-monster-rpg-icons/24.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_trigger_scaled_by_copies"
stacking_notes = "Round start HP loss happens once; healing multiplier scales by copies."
event_name = &"round_started"
effect_type = &"lose_current_hp_percent_then_heal_over_time"
value = 0.5
duration = 30.0
damage_scale = 1.5

[resource]
script = ExtResource("1_def")
id = &"blood_renewal_idol"
display_name = "Blood Renewal Idol"
description = "At round start, lose half your current HP, then heal it back over time."
category = &"defense"
rarity = &"legendary"
tags = Array[StringName]([&"RoundStart", &"Heal", &"HP"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
