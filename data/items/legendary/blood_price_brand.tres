[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/PermanentGrowthEffect.gd" id="2_growth"]
[ext_resource type="Texture2D" path="res://assets/items/dark_realistic_pixel_icons/blood_price_brand.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_growth")
stacking_notes = "Track HP damage taken. Every 10 HP lost grants +1 ATK. One shared listener; base round cap is +5 ATK, each extra copy adds +3 round cap."
trigger = &"damage_taken"
growth_stat = &"atk"
growth_value = 1.0
trigger_value = 10.0
round_cap = 5.0
stack_round_cap_bonus = 3.0

[resource]
script = ExtResource("1_def")
id = &"blood_price_brand"
display_name = "Blood Price Brand"
description = "Every 10 HP lost permanently gives +1 ATK, up to +5 per round."
category = &"attack"
rarity = &"legendary"
tags = Array[StringName]([&"OnDamageTaken", &"Attack", &"Scaling"])
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
