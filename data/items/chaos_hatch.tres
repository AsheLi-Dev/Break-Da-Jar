[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/rings-and-jewelry-game-icons/30.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
event_name = &"container_broken"
effect_type = &"container_break_random_proc"
chance = 1.0
damage_scale = 0.5
chain_count = 3
radius = 180.0
internal_cooldown = 0.05
choices = Array[StringName]([&"chain_lightning", &"fireball"])
only_direct_container_breaks = true

[resource]
script = ExtResource("1_def")
id = &"chaos_hatch"
display_name = "Chaos Hatch"
description = "Breaking a jar casts Chain Lightning or Fireball."
category = &"utility"
rarity = &"legendary"
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
