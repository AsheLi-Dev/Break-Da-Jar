[gd_resource type="Resource" script_class="ItemDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/StatModifierEffect.gd" id="2_stat"]
[ext_resource type="Texture2D" path="res://assets/items/rings-and-jewelry-game-icons/34.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("2_stat")
stat_name = &"chain_lightning_damage_scale_override"
operation = &"set_or_add_one"
value = 1.5

[sub_resource type="Resource" id="Resource_containers"]
script = ExtResource("2_stat")
stat_name = &"chain_lightning_can_target_containers"
operation = &"set"
value = 1.0

[resource]
script = ExtResource("1_def")
id = &"storm_greed"
display_name = "Storm Greed"
description = "Chain Lightning deals 150% ATK damage and can hit jars."
category = &"attack"
rarity = &"legendary"
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_damage"), SubResource("Resource_containers")])
