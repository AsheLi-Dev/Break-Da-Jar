[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/rings-and-jewelry-game-icons/10.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"chance_multiplicative"
stacking_notes = "Proc chance stacks as 1 - (1 - 0.1)^copies; one listener handles all copies."
event_name = &"attack_started"
effect_type = &"fireball"
chance = 0.1
damage_scale = 1.2
radius = 80.0
internal_cooldown = 0.15

[resource]
script = ExtResource("1_def")
id = &"solar_ember"
display_name = "Solar Ember"
description = "Attacks have a 10% chance to fire an explosive Fireball."
category = &"attack"
rarity = &"rare"
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
