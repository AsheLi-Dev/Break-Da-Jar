[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/items/ItemDefinition.gd" id="1_def"]
[ext_resource type="Script" path="res://systems/items/effects/EventEffect.gd" id="2_event"]
[ext_resource type="Texture2D" path="res://assets/items/_unused/Demon Loot Vector Icons/39.png" id="item_icon"]

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("2_event")
stacking_rule = &"shared_sequence_scaled"
stacking_notes = "One listener handles all copies. First copy triggers Chain Lightning twice; extra copies add 1 trigger. Triggers are 0.5s apart."
event_name = &"enemy_killed"
effect_type = &"chain_lightning_on_bleeding_death"
damage_scale = 0.5
chain_count = 3
max_stacks = 2
radius = 180.0
chance = 0.5
internal_cooldown = 0.05

[resource]
script = ExtResource("1_def")
id = &"bloodbolt_covenant"
display_name = "Bloodbolt Covenant"
description = "When a Bleeding enemy dies, trigger Chain Lightning twice from its position, 0.5 seconds apart. Extra copies add 1 additional trigger."
category = &"attack"
rarity = &"legendary"
icon = ExtResource("item_icon")
effects = Array[Resource]([SubResource("Resource_effect")])
